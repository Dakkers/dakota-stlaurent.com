{
  "name": "dakota-stlaurent-com",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --config .config/vite.config.ts --port 3000",
    "build": "vite build --config .config/vite.config.ts",
    "preview": "vite preview --config .config/vite.config.ts",
    "test": "vitest run --config .config/vitest.config.ts",
    "deploy": "pnpm build && wrangler deploy",
    "lint": "oxlint -c .config/oxlint.config.ts --fix",
    "fmt": "oxfmt -c .config/oxfmt.config.ts --ignore-path .gitignore --ignore-path .config/.oxfmtignore",
    "fmt:check": "oxfmt -c .config/oxfmt.config.ts --ignore-path .gitignore --ignore-path .config/.oxfmtignore --check",
    "typecheck": "tsc --noEmit",
    "lint:check": "oxlint -c .config/oxlint.config.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "1.39.0",
    "@tailwindcss/vite": "4.3.0",
    "@tanstack/react-devtools": "0.10.12",
    "@tanstack/react-router": "1.170.38",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.168.57",
    "@tanstack/router-plugin": "1.168.11",
    "lucide-react": "0.545.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "10.1.0",
    "tailwindcss": "4.3.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@storybook/react-vite": "10.6.0",
    "@tailwindcss/typography": "0.5.19",
    "@tanstack/devtools-vite": "0.8.5",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.19.19",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "jsdom": "28.1.0",
    "oxfmt": "0.52.0",
    "oxlint": "1.67.0",
    "storybook": "10.6.0",
    "typescript": "6.0.3",
    "vite": "8.0.14",
    "vitest": "4.1.7",
    "wrangler": "4.95.0"
  },
  "engines": {
    "node": ">=26.10.0 <27",
    "pnpm": ">=11.1.2 <12"
  },
  "packageManager": "pnpm@11.1.2"
}
